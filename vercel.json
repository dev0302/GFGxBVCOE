{
    "rewrites": [
        {
            "source": "/blog",
            "destination": "/api/og-blog"
        },
        {
            "source": "/blog/",
            "destination": "/api/og-blog"
        },
        {
            "source": "/blog/post/:slug",
            "destination": "/api/og-blog-post?slug=:slug"
        },
        {
            "source": "/(.*)",
            "destination": "/"
        }
    ]
}