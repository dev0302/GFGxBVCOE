DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/<database>
GITHUB_TOKEN=<optional-github-token-for-higher-api-rate-limits>
JWT_SECRET=<long-random-secret>
CLOUD_NAME=<cloudinary-cloud-name>
API_KEY=<cloudinary-api-key>
API_SECRET=<cloudinary-api-secret>
BREVO_API_KEY=<brevo-api-key>
SENDER_EMAIL=<sender-email-address>
FRONTEND_URL=<frontend-base-url>   # e.g. https://www.gfg-bvcoe.com — used for blog approval email links

# VectorVision repository-dispatch trigger (server-side only; do not expose to Vite)
GITHUB_ACTIONS_TOKEN=<github-token-with-contents-write>
GITHUB_ACTIONS_REPOSITORY=<owner>/<repository>
GITHUB_DISPATCH_EVENT=trigger_batch_ingestion
